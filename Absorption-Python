def robot_send_signal():
    test = 1
    data = 1
    arduino_com.write(bytes('1', 'utf-8'))
    time.sleep(2)
    data = arduino_com.readline()
    time.sleep(2)
    test = int(data)
    print(test)

def robot_wait():
    test = 1
    data = 1
    while test < 20:
        arduino_com.write(bytes('3', 'utf-8'))
        time.sleep(2)
        data = arduino_com.readline()
        print(data)
        time.sleep(2)
        test = int(data)
        print(test)
    
