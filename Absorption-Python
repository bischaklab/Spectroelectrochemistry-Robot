# Defining functions

def open_gripper_med():
    arduino.write(format(('{}\n').format(25)).encode()) # write position to serial port
    protocol.delay(seconds=1)
    time.sleep(0.1)
    reachedPos = str(arduino.readline())
    protocol.delay(seconds=0.5)

def open_gripper():
    arduino.write(format(('{}\n').format(0)).encode()) # write position to serial port
    protocol.delay(seconds=1)
    time.sleep(0.1)
    reachedPos = str(arduino.readline())
    protocol.delay(seconds=0.5)
    
def close_gripper():
    arduino.write(format(('{}\n').format(180)).encode()) # write position to serial port
    protocol.delay(seconds=1)
    time.sleep(0.1)
    reachedPos = str(arduino.readline())
    protocol.delay(seconds=0.5)
    
    
